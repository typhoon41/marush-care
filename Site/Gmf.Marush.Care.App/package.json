{
  "name": "Marush",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start:aspire": "run-script-os",
    "start:aspire:win32": "ng serve --configuration=development,sr --port %PORT%",
    "start:aspire:default": "ng serve --configuration=development,sr --port $PORT",
    "start": "ng serve --configuration=development,sr",
    "start-en": "ng serve --configuration=development,en",
    "start-ru": "ng serve --configuration=development,ru",
    "build": "ng build && copyfiles -E -u 2 src/assets/**/* dist/browser/assets",
    "watch": "ng build --watch --configuration development",
    "pretest": "node tests/unit/clean-test-output.mjs",
    "test": "ng test",
    "posttest": "node tests/unit/clean-test-output.mjs",
    "test:ssr": "node --test tests/ssr/ssr-baseline.test.mjs",
    "test:ssr:record": "node tests/ssr/record.mjs",
    "translate": "ng extract-i18n && sortjson src/locale",
    "serve:ssr": "node dist/server/server.mjs",
    "lint": "eslint --fix && stylelint --fix src/**/*.scss",
    "lint:ci": "eslint && stylelint \"src/**/*.scss\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/localize": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-server": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/ssr": "^20.3.43",
    "air-datepicker": "3.5.3",
    "express": "^5.3.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2"
  },
  "warnings": ["DO NOT UPDATE AIR DATEPICKER to 3.6.0, it shows Russian language when English is set"],
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@types/express": "^5.0.3",
    "@types/node": "22.13.8",
    "@typhoon41/eslint-config-angular": "1.1.1",
    "@typhoon41/scss-solutions": "0.2.1",
    "@typhoon41/stylelint-config": "1.1.2",
    "copyfiles": "2.4.1",
    "jsdom": "31.0.1",
    "json-sort-cli": "4.0.10",
    "run-script-os": "1.1.6",
    "typescript": "~5.9.2",
    "vitest": "3.2.7"
  }
}
